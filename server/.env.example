# Kaziforce Admin & Moderation API — environment template.
# Copy to .env and fill in. server/.env is gitignored; never commit real values.
# `npm run bootstrap` (one-time, run by the operator) generates both database
# credentials and this file for you.

# Application runtime connection (kaziforce_app — restricted grants, see migration 006)
DATABASE_URL=postgresql://kaziforce_app:REPLACED_BY_BOOTSTRAP@localhost:5432/kaziforce

# Migration/seed connection (kaziforce_owner — owns the schema)
OWNER_DATABASE_URL=postgresql://kaziforce_owner:REPLACED_BY_BOOTSTRAP@localhost:5432/kaziforce

# API
PORT=3000
NODE_ENV=development

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
JWT_TTL_HOURS=8

# Rate limiting (BED Part VI convention; in-memory fixed window, see D-018)
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW_MS=300000

# Moderation suggestion model service (ml/service.py). Loopback only — never
# exposed through Nginx. The client fails safe if this is down or slow.
# `npm run dev:all` sets this itself from its MODEL_PORT, so the URL always
# matches the port the service actually listens on.
MODEL_SERVICE_URL=http://127.0.0.1:8000
MODEL_TIMEOUT_MS=3000

# Cap on one audit CSV export (rows). If a filter matches more rows than this,
# the export ends with an explicit 'Export Truncated' marker row and an
# X-Total-Matching-Rows response header, so a truncated file is never mistaken
# for the complete ledger.
AUDIT_EXPORT_MAX_ROWS=10000

# ---------------------------------------------------------------------------
# Production seeding ONLY (NODE_ENV=production)
# The seed script refuses the development demo passwords in production and
# requires these instead. They are never printed. Omit them in development,
# where the demo passwords are used.
# ---------------------------------------------------------------------------
SEED_VIEWER_PASSWORD=
SEED_MODERATOR_PASSWORD=
SEED_SUPERADMIN_PASSWORD=
