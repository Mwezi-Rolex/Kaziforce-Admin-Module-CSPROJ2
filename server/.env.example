# Kaziforce Admin & Moderation API — environment template.
# Copy to .env and fill in. server/.env is gitignored; never commit real values.
# `npm run bootstrap` (one-time, run by the operator) generates both database
# credentials and this file for you.

# Application runtime connection (kaziforce_app — restricted grants, see migration 006)
DATABASE_URL=postgresql://kaziforce_app:REPLACED_BY_BOOTSTRAP@localhost:5432/kaziforce

# Migration/seed connection (kaziforce_owner — owns the schema)
OWNER_DATABASE_URL=postgresql://kaziforce_owner:REPLACED_BY_BOOTSTRAP@localhost:5432/kaziforce

# API
PORT=3000
NODE_ENV=development

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
JWT_TTL_HOURS=8

# Rate limiting (BED Part VI convention; in-memory fixed window, see D-018)
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW_MS=300000
