# Kaziforce — production environment for the Node API
#
# Install to /etc/kaziforce/api.env (mode 0640, owner root:kaziforce) and
# reference it from deploy/systemd/kaziforce-api.service.
#
#   sudo install -o root -g kaziforce -m 0640 deploy/.env.production.example /etc/kaziforce/api.env
#   sudo nano /etc/kaziforce/api.env        # fill the placeholders
#
# NEVER commit the real file. This template contains no secrets.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# Behind Nginx: honour X-Forwarded-For so the rate limiter sees the real client
# address, not the proxy. 1 = trust one proxy hop (the local Nginx).
TRUST_PROXY=1

# ---------------------------------------------------------------------------
# Database — application role (restricted grants; see deploy/sql/02_grants.sql)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Use 127.0.0.1 rather than "localhost" to force TCP and avoid socket surprises.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://kaziforce_app:CHANGE_ME_APP_PASSWORD@127.0.0.1:5432/kaziforce

# Schema-owner connection. Only needed for `npm run migrate` and `npm run seed`,
# which you run once during deployment. Leave it here or remove it afterwards;
# the API never reads it. Removing it is the tighter option.
OWNER_DATABASE_URL=postgresql://kaziforce_owner:CHANGE_ME_OWNER_PASSWORD@127.0.0.1:5432/kaziforce

# ---------------------------------------------------------------------------
# Auth
# Generate with:  openssl rand -base64 48
# Changing this value invalidates every existing session cookie.
# ---------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_48
JWT_TTL_HOURS=8

# ---------------------------------------------------------------------------
# Rate limiting (per client IP)
# ---------------------------------------------------------------------------
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW_MS=300000

# ---------------------------------------------------------------------------
# Model service (localhost only — never exposed through Nginx)
# The API fails safe if this is unreachable: the queue shows
# "Suggestion unavailable" and every moderation action still works.
# ---------------------------------------------------------------------------
MODEL_SERVICE_URL=http://127.0.0.1:8000
MODEL_TIMEOUT_MS=800
